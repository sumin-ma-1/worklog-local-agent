# https://my.telegram.org → API development tools (서버 공용, 사용자 UI에 표시하지 않음)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# BotFather 봇 토큰 (유저별 비서 long polling)
# TELEGRAM_BOT_TOKEN=

# 텔레그램 「대시보드 열기」 버튼 URL (기본 http://127.0.0.1:8787)
# DASHBOARD_URL=http://127.0.0.1:8787

# 로컬 Ollama (미설정 시 config.yaml 기본값 사용)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
